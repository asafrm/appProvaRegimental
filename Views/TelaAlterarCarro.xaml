<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="appProvaRegimental.Views.TelaAlterarCarro"
             BackgroundImageSource="fundo.png"
             Title="Alterar Carro">

    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="iconsalvarcarro.jpg" Clicked="ToolbarItemClickedSalvar" />
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <StackLayout>
            <Border Stroke="#FFFFFF" Padding="10,5" Margin="4" StrokeShape="RoundRectangle 8,0">
                <Entry Placeholder="Nome do Carro:" x:Name="txtNomeCarro" FontAttributes="Bold" Text="{Binding carNome}" Margin="4" ClearButtonVisibility="WhileEditing" />
            </Border>
            <Border Stroke="#FFFFFF" Padding="10,5" Margin="4" StrokeShape="RoundRectangle 8,0">
                <Entry Placeholder="Placa do Carro:" x:Name="txtPlacaCarro" FontAttributes="Bold" Text="{Binding carPlaca}" Margin="4" ClearButtonVisibility="WhileEditing" />
            </Border>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>