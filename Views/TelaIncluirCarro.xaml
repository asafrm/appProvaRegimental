<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="appProvaRegimental.Views.TelaIncluirCarro"
             BackgroundImageSource="fundo.png"
             Title="Cadastrar Carro">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Salvar" IconImageSource="iconesalvarcarro.png" Clicked="ToolbarItemClickedSalvar"/>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <StackLayout>
            <Border Stroke="#ffff" Padding="10,5" Margin="4" StrokeShape="RoundRectangle 8,0">
                <Entry Placeholder="Nome do Carro:" x:Name="txtNomeCarro" FontAttributes="Bold" Margin="4" ClearButtonVisibility="WhileEditing"/>
            </Border>
            <Border Stroke="#ffff" Padding="10,5" Margin="4" StrokeShape="RoundRectangle 8,0">
                <Entry Placeholder="Placa do Carro:" x:Name="txtPlacaCarro" FontAttributes="Bold" Margin="4" ClearButtonVisibility="WhileEditing"/>
            </Border>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>
